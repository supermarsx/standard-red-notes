{
  "name": "@standard-red-notes/openclaw",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/supermarsx/standard-red-notes/tree/main/openclaw#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supermarsx/standard-red-notes.git",
    "directory": "openclaw"
  },
  "bugs": {
    "url": "https://github.com/supermarsx/standard-red-notes/issues"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "description": "Open Claw — Standard Red Notes personal assistant agent.",
  "bin": {
    "openclaw": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md",
    "release-package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "package:release": "node scripts/package-release.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "yarn workspace @standard-red-notes/mcp build && yarn build && node test/live.e2e.js",
    "verify:release": "node scripts/verify-release.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\" \"test/**/*.{ts,tsx,js,json,md}\" \"scripts/**/*.mjs\" README.md package.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json,md}\" \"test/**/*.{ts,tsx,js,json,md}\" \"scripts/**/*.mjs\" README.md package.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "openai": "^6.47.0",
    "toml": "^5.0.0",
    "zod": "^4.4.3"
  },
  "bundleDependencies": [
    "@anthropic-ai/sdk",
    "@modelcontextprotocol/sdk",
    "openai",
    "toml",
    "zod"
  ],
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
