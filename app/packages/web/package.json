  "scripts": {
    "build": "yarn clean && yarn copy:components && webpack --config web.webpack.prod.js && node scripts/AssertPortableBundle.mjs",
    "clean": "rm -fr dist",
    "format": "prettier --write src/javascripts",
    "lint": "eslint src/javascripts && yarn lint:css-vars && yarn lint:scss",
    "lint:css-vars": "node scripts/CheckCssVarBrackets.mjs",
    "lint:fix": "eslint src/javascripts --fix",
    "lint:scss": "stylelint \"src/stylesheets/**/*.scss\"",
    "start": "webpack-dev-server --config web.webpack.dev.js",
    "start-secure": "yarn start --https",
    "test": "jest --config jest.config.js",
    "tsc": "tsc --project tsconfig.json",
    "upgrade:snjs": "ncu -u '@standardnotes/*'",
    "watch": "webpack -w --config web.webpack.dev.js",
    "copy:components": "node scripts/CopyComponents.mjs"
  },
