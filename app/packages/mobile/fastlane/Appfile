for_platform :ios do
  for_lane :build_prod do
    app_identifier "com.standardnotes.standardnotes"
  end

  for_lane :upload_prod do
    app_identifier "com.standardnotes.standardnotes"
  end

  for_lane :submit_prod do
    app_identifier "com.standardnotes.standardnotes"
  end

  for_lane :distribute_prod do
    app_identifier "com.standardnotes.standardnotes"
  end
end

for_platform :android do
  for_lane :build_prod do
    package_name 'com.standardnotes'
  end

  for_lane :publish_prod do
    package_name 'com.standardnotes'
  end
end
