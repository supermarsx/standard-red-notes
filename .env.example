# =============================================================================
# Standard Red Notes - environment configuration (EXAMPLE / placeholders only)
#
# DO NOT use these values as-is. Run the setup script to generate a real .env
# with securely-generated secrets:
#
#   macOS / Linux:  ./scripts/setup.sh
#   Windows:        ./scripts/setup.ps1
#
# The real .env is git-ignored. Never commit it - it contains secrets.
# Every value marked CHANGE-ME below must be replaced with a 64-char hex string
# (32 random bytes), e.g. `openssl rand -hex 32`.
# =============================================================================

# ----- Host port (the ONLY port published on the host machine) ---------------
# The app's nginx front door proxies the API (/v1 etc.), files (/files/) and
# the realtime websocket (/sockets) same-origin, so the API gateway and files
# service are internal-only and publish no host ports.
APP_PORT=3001

# ----- Database (MariaDB) ----------------------------------------------------
MYSQL_DATABASE=standard_notes_db
MYSQL_USER=std_notes_user
MYSQL_PASSWORD=CHANGE-ME-random-hex-32
MYSQL_ROOT_PASSWORD=CHANGE-ME-random-hex-32

# MariaDB resilience / capacity defaults. Keep DB_MAX_CONNECTIONS above the sum
# of active service pools (DB_CONNECTION_LIMIT times the DB-using processes).
DB_CONNECTION_LIMIT=20
DB_MAX_CONNECTIONS=150
DB_MAX_QUERY_EXECUTION_TIME=45000
DB_INNODB_BUFFER_POOL_SIZE=512M
DB_MAX_ALLOWED_PACKET=128M
DB_INNODB_FLUSH_LOG_AT_TRX_COMMIT=1

# ----- Required server secrets (the stack will not start without these) ------
# 64-char hex (32 bytes). The encryption key MUST be exactly 32 bytes of hex.
AUTH_JWT_SECRET=CHANGE-ME-random-hex-32
AUTH_SERVER_ENCRYPTION_SERVER_KEY=CHANGE-ME-random-hex-32
VALET_TOKEN_SECRET=CHANGE-ME-random-hex-32

# Pseudo key-params seed. Auto-generated by the container if unset, but then it
# changes on every restart; pin it here so login key-params stay stable.
AUTH_SERVER_PSEUDO_KEY_PARAMS_KEY=CHANGE-ME-random-hex-32

# ----- Realtime websocket gateway --------------------------------------------
# Shared secrets between the server and the websocket-gateway. Must match.
WEBSOCKET_GATEWAY_INTERNAL_SECRET=CHANGE-ME-random-hex-32
WEB_SOCKET_CONNECTION_TOKEN_SECRET=CHANGE-ME-random-hex-32

# ----- Domain / cookies / origins --------------------------------------------
# Empty COOKIE_DOMAIN => host-only cookie (works on localhost / any bare host/IP).
# For an HTTPS deployment behind a domain, set COOKIE_DOMAIN to your domain and
# COOKIE_SECURE=true so the auth cookie is only sent over HTTPS.
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Public base URL browsers use for file uploads/downloads. Served by the app
# front door's /files/ proxy, so it is the app origin + /files. For a real
# deployment: https://notes.example.com/files
PUBLIC_FILES_SERVER_URL=http://localhost:3001/files

# ----- Reverse proxy ---------------------------------------------------------
# Controls express's "trust proxy" so req.secure / req.protocol / req.ip honor
# the X-Forwarded-Proto / X-Forwarded-For headers your proxy sets. The default
# (applied by docker-compose.yml when unset) trusts a proxy on loopback or a
# private/Docker network, which covers the usual compose-behind-a-proxy setup
# while still allowing direct, non-proxied access. Override only if your proxy
# sits on a public IP (then use a CSV of its IPs/subnets, a hop count, or "true").
# When serving over HTTPS through the proxy, ALSO set COOKIE_SECURE=true (and
# COOKIE_DOMAIN). See docs/self-hosting.md "Running behind a reverse proxy".
# TRUST_PROXY=loopback, linklocal, uniquelocal
#
# Optional: take the client IP from a single named header your proxy/CDN sets
# (e.g. X-Real-IP, or Cloudflare's CF-Connecting-IP). When set it takes precedence
# over req.ip for rate limiting, IP allow/block lists and the session IP. OFF by
# default. SPOOFABLE unless you are genuinely behind a proxy that sets this header
# AND strips any inbound copy — do not enable on a directly-reachable instance.
# See docs/DEPLOYMENT.md "Forwarded client IP".
# CLIENT_IP_HEADER=

# WebAuthn / hardware-key (U2F) relying party. Should match where the app is served.
AUTH_SERVER_U2F_RELYING_PARTY_ID=localhost
AUTH_SERVER_U2F_EXPECTED_ORIGIN=http://localhost:3001,http://localhost

# ----- Admin -----------------------------------------------------------------
# Comma-separated emails granted the in-app Admin panel and /admin endpoints.
ADMIN_EMAILS=

# =============================================================================
# Optional settings (uncomment and edit as needed). Defaults are applied by
# docker-compose.yml when these are left unset.
# =============================================================================
# LOG_LEVEL=info
# COOKIE_SAME_SITE=Lax
# COOKIE_PARTITIONED=false
#
# STANDARD_RED_FEATURES_MODE=included
# STANDARD_RED_ENTITLEMENT_MODE=included
# STANDARD_RED_FULL_FEATURE_FILE_UPLOAD_BYTES_LIMIT=-1
# HTTP_REQUEST_PAYLOAD_LIMIT_MEGABYTES=50
# MAX_CHUNK_BYTES=100000000
# MAX_ATTACHMENT_BYTE_SIZE=5368709120
#
# Outbound SMTP. EMAIL_BACKUPS_ENABLED remains off unless explicitly enabled;
# backup files contain already end-to-end-encrypted item payloads.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# EMAIL_BACKUPS_ENABLED=false
# EMAIL_ATTACHMENT_MAX_BYTE_SIZE=10485760
#
# Optional S3 storage for generated email-backup attachments. When unset, the
# shared uploads volume is used. Set the complete group together.
# S3_AWS_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BACKUP_BUCKET_NAME=
#
# Client-side PDF OCR (tesseract.js). Files are end-to-end encrypted, so OCR runs
# in the browser, NOT on the server — these flags only gate whether the web client
# offers the "Extract text (OCR)" action and which language it defaults to. OFF by
# default (OCR downloads multi-MB language data at runtime, is slow, accuracy varies).
# OCR_ENABLED=false
# OCR_DEFAULT_LANGUAGE=eng
#
# REVISIONS_RETENTION_DAYS=0
# REVISIONS_MAX_COUNT_PER_ITEM=0
#
# Redis runtime ceiling inside the cache container. Keep this below CACHE_MEM_LIMIT
# so Redis returns controlled errors instead of the container being OOM-killed.
# CACHE_MEM_LIMIT=256m
# CACHE_MAXMEMORY=192mb
# CACHE_MAXMEMORY_POLICY=noeviction
#
# AUTH_SERVER_U2F_RELYING_PARTY_NAME=Standard Red Notes
#
# ASSISTANT_ANTHROPIC_API_KEY=
# ASSISTANT_OPENAI_API_KEY=
# ASSISTANT_OPENAI_BASE_URL=
# ASSISTANT_OPENAI_MODEL=
# ASSISTANT_OLLAMA_URL=
# ASSISTANT_DEFAULT_PROVIDER=
# ASSISTANT_DEFAULT_MODEL=
# Per-user, per-day AI assistant REQUEST cap enforced by the server proxy (not a
# token cap). 0 / unset = unlimited (opt-in). Per-user overrides come from the
# AI_REQUEST_LIMIT user setting. When set, the web footer surfaces "AI: used / limit"
# with a near-limit warning color; the proxy refuses requests past the cap (HTTP 429).
# ASSISTANT_DAILY_REQUEST_LIMIT=0
# Optional per-user authenticated operation tier for expensive endpoints such as
# assistant streaming. 0 / unset = off.
# RATE_LIMIT_USER_WINDOW_SECONDS=60
# RATE_LIMIT_USER_MAX=0
# RATE_LIMIT_ADAPTIVE_ESCALATION=false
#
# Signup safety caps. 0 = unlimited/open self-host behavior.
# REGISTRATION_SIGNUPS_PER_IP_MAX=0
# REGISTRATION_SIGNUPS_PER_IP_WINDOW_HOURS=24
# REGISTRATION_SIGNUPS_PER_WEEK_MAX=0
# REGISTRATION_SIGNUPS_PER_DEVICE_MAX=0
# REGISTRATION_SIGNUPS_PER_DEVICE_WINDOW_HOURS=24
# REGISTRATION_MAX_TOTAL_ACCOUNTS=0
# REGISTRATION_INVITE_ONLY=false
# REGISTRATION_APPROVAL_REQUIRED=false
#
# Image override hooks for digest-pinned production deployments. Leave commented
# for the repository defaults; set to exact tags or repo@sha256 digests when you
# want reproducible pulls.
# MARIADB_IMAGE=mariadb:12.3.2
# REDIS_IMAGE=redis:8.8.0-alpine
# FLOCI_IMAGE=floci/floci:1.5.33-compat
# N8N_IMAGE=n8nio/n8n:2.30.5
# DOCKER_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:v0.4.2
#
# STANDARD_RED_NOTES_EMAIL=
# STANDARD_RED_NOTES_PASSWORD=
# STANDARD_RED_NOTES_ALLOW_WRITES=0
#
# ----- MCP autonomous HTTP service (optional, `--profile mcp`) ----------------
# The mcp service can run as a long-lived HTTP server (MCP_TRANSPORT=http) on the
# internal network at mcp:3010 (NOT published to the host). MCP_HTTP_TOKEN is the
# REQUIRED bearer token callers must present — generate a real one before
# starting the profile (e.g. `openssl rand -hex 32`). Empty or short values make
# the MCP process fail closed; they never create an unauthenticated endpoint.
# MCP_HTTP_TOKEN=CHANGE-ME-random-hex-32
# MCP_HTTP_MAX_BODY_BYTES=1048576
# MCP_HTTP_MAX_SESSIONS=32
# MCP_HTTP_SESSION_IDLE_MS=300000
# MCP_HTTP_BODY_TIMEOUT_MS=10000
# MCP_HTTP_REQUEST_TIMEOUT_MS=60000
#
# Prefer a server-issued read-only or read-write MCP token over an account
# password. This credential authenticates the bridge to Standard Red Notes and
# MUST be different from MCP_HTTP_TOKEN, which authenticates callers to the
# bridge. The token value is never written to service logs.
# STANDARD_RED_NOTES_MCP_TOKEN=
#
# File attachment and export tools are disabled while these roots are empty.
# Values are colon-delimited absolute paths INSIDE the Linux MCP container and
# require matching volume mounts in a local Compose override. Do not point them
# at the MCP account/session data directory.
# STANDARD_RED_NOTES_FILE_ROOTS=
# STANDARD_RED_NOTES_EXPORT_ROOTS=
# STANDARD_RED_NOTES_MAX_ATTACHMENT_BYTES=16777216
# STANDARD_RED_NOTES_MAX_EXPORT_BYTES=134217728
#
# ----- Opt out of the insecure-default secret guard (LOCAL DEV ONLY) ----------
# The server refuses to boot if AUTH_SERVER_ENCRYPTION_SERVER_KEY / AUTH_JWT_SECRET
# / VALET_TOKEN_SECRET are still the published placeholder values. For a throwaway
# local instance that is NOT publicly exposed you can bypass that check. Never set
# this on an internet-facing deployment.
# ALLOW_INSECURE_DEFAULTS=true
#
# ----- Optional server-wide shared access key ("obfuscation gate") -----------
# OFF by default (leave SHARED_SERVER_ACCESS_KEY empty/unset => zero behavior
# change). When set, the api-gateway refuses requests that do not present this
# key in the X-Shared-Server-Key header. This is OBFUSCATION / access-gating for
# a self-hosted instance so a casual scanner who finds the server cannot use it
# without the key. It is NOT end-to-end security and NOT a user password -- real
# confidentiality of note content is still the client-side E2E encryption. Enter
# the same key in each client under Preferences > Security > Server Access Key.
# Mode selects what is gated: "all" (every request; the /healthcheck path is
# always exempt so the container stays healthy) or "registration" (only new
# account sign-ups, leaving existing users unaffected).
# SHARED_SERVER_ACCESS_KEY=CHANGE-ME-random-hex-32
# SHARED_SERVER_ACCESS_KEY_MODE=all
