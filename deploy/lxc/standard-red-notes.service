[Unit]
Description=Standard Red Notes (single-process home-server)
Documentation=https://github.com/standardnotes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__WORKING_DIR__
# Launches: node --require <repo>/server/.pnp.cjs dist/bin/server.js
# (dotenv reads the .env in WorkingDirectory; sqlite + in-memory cache, no
# external services). The installer templates the paths in.
ExecStart=__LAUNCHER__
Restart=on-failure
RestartSec=5
# Give the sqlite schema build room on first boot.
TimeoutStartSec=120

# The root-owned release is read-only; only persistent data may be mutated.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=__DATA_DIR__
UMask=0027

[Install]
WantedBy=multi-user.target
