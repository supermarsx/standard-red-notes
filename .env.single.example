# Standard Red Notes — ALL-IN-ONE single container config.
# Copy to `.env`, then: docker compose -f docker-compose.single.yml up -d --build
#
# EVERYTHING here is OPTIONAL. With an empty .env (or none), the container comes
# up on http://localhost:3001 and auto-generates + persists strong per-instance
# secrets. Set values below only to customize.

# Host port the app is published on (container listens on 8080 internally).
APP_PORT=3001

# --- Secrets ---------------------------------------------------------------
# Recommended for any long-lived instance you want to back up / move: pin these
# so a fresh volume reproduces the same instance. Generate each with:
#   openssl rand -hex 32
# ENCRYPTION_SERVER_KEY MUST be 64 hex chars (32 bytes).
# If you leave them blank they are generated once and stored in the data volume
# at /data/secrets.env — do NOT change them afterwards (it invalidates sessions
# and encrypted MFA secrets).
#AUTH_JWT_SECRET=
#JWT_SECRET=
#ENCRYPTION_SERVER_KEY=
#PSEUDO_KEY_PARAMS_KEY=
#VALET_TOKEN_SECRET=

# Current clients support password (v2) and TOTP (v3) step-up proof. Raise
# these only for a deliberate staged client rollout.
#APPLICATION_VERSION_THRESHOLD_FOR_TOKEN_VERSION_2=0.0.0
#APPLICATION_VERSION_THRESHOLD_FOR_TOKEN_VERSION_3=0.0.0

# --- Basics ----------------------------------------------------------------
#LOG_LEVEL=info
#SERVER_SETTINGS_PATH=/data/server-settings.json
# After registering an account, persist its administrator role locally with:
# docker compose -f docker-compose.single.yml exec app srn-admin roles grant <user> ADMIN_USER

# --- Behind a domain / HTTPS reverse proxy ---------------------------------
# Public URL the browser uses for file up/downloads (served same-origin at /files).
#PUBLIC_FILES_SERVER_URL=https://notes.example.com/files
# Required before enabling workflows or ChatGPT/Codex pairing. Use the exact
# browser-facing origin; the server deliberately does not trust request Host.
#PUBLIC_URL=https://notes.example.com
#WORKFLOWS_ENABLED=false
#WORKFLOWS_PUBLIC_URL=https://automation.example.net
#COOKIE_DOMAIN=notes.example.com
#COOKIE_SECURE=true
# Point the web app at a specific sync origin (default: the page's own origin).
#SYNC_SERVER=https://notes.example.com

# Durable sync is worker-WebSocket preferred and HTTP fallback by default. The
# all-in-one image deliberately has no bundled Redis; to enable its server-side
# socket command plane, point REDIS_HOST at a Redis instance reachable only on
# the same private trusted network. This host/port connector does not support
# Redis authentication or TLS; do not expose it or route it across trust
# boundaries. Without exact PUBLIC_URL + Redis, capability negotiation stays
# closed and clients use HTTP.
# The single-process HomeServer calls its durable sync journal directly, so the
# multi-service SYNCING_SERVER_INTERNAL_GRPC_AUTH_SECRET is intentionally unused.
#WEBSOCKET_SYNC_ENABLED=true
#WEBSOCKET_SYNC_ALLOWED_ORIGINS=
#WEBSOCKET_SYNC_MAX_SOCKETS_PER_USER=4
#WEBSOCKET_SYNC_REDIS_KEY_PREFIX=srn:ws-sync:v1
#WEBSOCKET_SYNC_REDIS_OPERATION_TIMEOUT_MS=1500
#WEBSOCKET_SYNC_COMMAND_LEASE_TTL_MS=30000
#WEBSOCKET_SYNC_SOCKET_LEASE_TTL_MS=75000
#REDIS_HOST=
#REDIS_PORT=6379

# --- Client-side PDF OCR (off by default) ----------------------------------
#OCR_ENABLED=false
#OCR_DEFAULT_LANGUAGE=eng

# --- Optional access gating ------------------------------------------------
# Require every client to present X-Shared-Server-Key: <key>. Empty = off.
#SHARED_SERVER_ACCESS_KEY=
#SHARED_SERVER_ACCESS_KEY_MODE=all

# --- Operation safety limits -----------------------------------------------
# Unauthenticated auth-adjacent endpoint tiers. RATE_LIMIT_ENABLED=false turns
# them off; leaving it blank uses the safe defaults below.
#RATE_LIMIT_ENABLED=
#RATE_LIMIT_WINDOW_SECONDS=60
#RATE_LIMIT_LOGIN_MAX=10
#RATE_LIMIT_REGISTRATION_MAX=5
# Optional authenticated per-user tier for expensive endpoints. 0 = off.
#RATE_LIMIT_USER_WINDOW_SECONDS=60
#RATE_LIMIT_USER_MAX=0
#RATE_LIMIT_ADAPTIVE_ESCALATION=false
# Signup caps. 0 = unlimited/open self-host behavior.
#REGISTRATION_SIGNUPS_PER_IP_MAX=0
#REGISTRATION_SIGNUPS_PER_IP_WINDOW_HOURS=24
#REGISTRATION_SIGNUPS_PER_WEEK_MAX=0
#REGISTRATION_SIGNUPS_PER_DEVICE_MAX=0
#REGISTRATION_SIGNUPS_PER_DEVICE_WINDOW_HOURS=24
#REGISTRATION_MAX_TOTAL_ACCOUNTS=0
#REGISTRATION_INVITE_ONLY=false
#REGISTRATION_APPROVAL_REQUIRED=false
# Request/upload bounds.
#HTTP_REQUEST_PAYLOAD_LIMIT_MEGABYTES=50
#MAX_CHUNK_BYTES=100000000
#FILE_DOWNLOAD_DEADLINE_MS=30000
#MAX_ATTACHMENT_BYTE_SIZE=5368709120

# --- Optional outbound email and encrypted backup delivery ----------------
# Admin -> Server -> Email delivery can persist live overrides. STARTTLS is the
# default; insecure mode is accepted only for a trusted loopback/private relay.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=
#SMTP_SECURE=false
#SMTP_ALLOW_INSECURE=false
#EMAIL_BACKUPS_ENABLED=false
#EMAIL_ATTACHMENT_MAX_BYTE_SIZE=10485760

# --- Optional AI assistant proxy -------------------------------------------
#ASSISTANT_ANTHROPIC_API_KEY=
#ASSISTANT_OPENAI_API_KEY=
#ASSISTANT_OPENAI_BASE_URL=
#ASSISTANT_OPENAI_MODEL=
#ASSISTANT_OLLAMA_URL=http://host.docker.internal:11434
#ASSISTANT_DEFAULT_PROVIDER=
#ASSISTANT_DEFAULT_MODEL=
#ASSISTANT_DAILY_REQUEST_LIMIT=0
# Guided ChatGPT/Codex subscription pairing. Supported setup scripts generate and
# preserve this internal key automatically. Set it manually only in advanced
# custom deployments, and never rotate it while pairings exist. /data is the
# stock named persistent volume.
#ASSISTANT_SUBSCRIPTION_ENCRYPTION_KEY=
#ASSISTANT_SUBSCRIPTION_TOKEN_PATH=/data/assistant-subscription.json
# Optional OAuth contract overrides (the shipped defaults are best-effort).
#ASSISTANT_CHATGPT_OAUTH_AUTHORIZE_URL=
#ASSISTANT_CHATGPT_OAUTH_TOKEN_URL=
#ASSISTANT_CHATGPT_OAUTH_CLIENT_ID=
#ASSISTANT_CHATGPT_OAUTH_REDIRECT_URI=
#ASSISTANT_CHATGPT_OAUTH_SCOPES=
#ASSISTANT_CHATGPT_OAUTH_ACCOUNT_ID_CLAIM=
# Compatibility-only direct bearer mode for the `default` slot. Prefer pairing.
#ASSISTANT_OPENAI_AUTH_MODE=
#ASSISTANT_OPENAI_SUBSCRIPTION_TOKEN=
#ASSISTANT_OPENAI_SUBSCRIPTION_BASE_URL=
#ASSISTANT_OPENAI_ACCOUNT_ID=
#ASSISTANT_OPENAI_BETA=
#ASSISTANT_OPENAI_EXTRA_HEADERS=

# Container memory ceiling.
#SINGLE_MEM_LIMIT=2g
