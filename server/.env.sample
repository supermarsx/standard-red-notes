######
# DB #
######

DB_HOST=db
DB_PORT=3306
DB_USERNAME=std_notes_user
DB_PASSWORD=changeme123
DB_DATABASE=standard_notes_db
DB_TYPE=mysql

#########
# CACHE #
#########

REDIS_PORT=6379
REDIS_HOST=cache
CACHE_TYPE=redis

# Worker WebSocket is the primary durable sync transport. Unset/true enables;
# exact false is the HTTP-fallback kill switch. Empty origins derive PUBLIC_URL.
WEBSOCKET_SYNC_ENABLED=true
WEBSOCKET_SYNC_ALLOWED_ORIGINS=
WEBSOCKET_SYNC_MAX_SOCKETS_PER_USER=4
WEBSOCKET_SYNC_REDIS_KEY_PREFIX=srn:ws-sync:v1
WEBSOCKET_SYNC_REDIS_OPERATION_TIMEOUT_MS=1500
WEBSOCKET_SYNC_COMMAND_LEASE_TTL_MS=30000
WEBSOCKET_SYNC_SOCKET_LEASE_TTL_MS=75000

########
# KEYS #
########

AUTH_JWT_SECRET=
AUTH_SERVER_ENCRYPTION_SERVER_KEY=
VALET_TOKEN_SECRET=
SYNCING_SERVER_INTERNAL_GRPC_AUTH_SECRET=
WEB_SOCKET_CONNECTION_TOKEN_SECRET=
WEBSOCKET_GATEWAY_INTERNAL_SECRET=
