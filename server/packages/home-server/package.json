{
  "name": "@standardnotes/home-server",
  "version": "1.23.3",
  "engines": {
    "node": ">=26.0.0"
  },
  "description": "Standard Notes Home Server",
  "main": "dist/src/index.js",
  "typings": "dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git@github.com:standardnotes/server.git",
    "directory": "packages/home-server"
  },
  "author": "Karol Sójko <karol@standardnotes.com>",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "clean": "rm -fr dist",
    "build": "tsc --build",
    "build:bundle": "yarn node esbuild.config.mjs",
    "package": "yarn node esbuild.config.mjs",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "jest --coverage --no-cache --config=./jest.config.js --maxWorkers=2",
    "start": "yarn node dist/bin/server.js"
  },
  "dependencies": {
    "@standardnotes/api-gateway": "workspace:^",
    "@standardnotes/auth-server": "workspace:^",
    "@standardnotes/domain-core": "workspace:^",
    "@standardnotes/domain-events": "workspace:^",
    "@standardnotes/domain-events-infra": "workspace:^",
    "@standardnotes/files-server": "workspace:^",
    "@standardnotes/revisions-server": "workspace:^",
    "@standardnotes/syncing-server": "workspace:^",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "inversify": "^8.1.3",
    "inversify-express-utils": "workspace:*",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@yarnpkg/esbuild-plugin-pnp": "^3.0.0-rc.15",
    "esbuild": "^0.28.1",
    "jest": "^30.4.2",
    "typescript": "6.0.3"
  }
}
