LOG_LEVEL=debug
NODE_ENV=development
E2E_TESTING=false
# Optional. When unset, Node keeps its existing unspecified-interface default.
# Set 127.0.0.1 when a same-host reverse proxy must be the only public edge.
# BIND_ADDRESS=127.0.0.1

JWT_SECRET=
AUTH_JWT_SECRET=
APPLICATION_VERSION_THRESHOLD_FOR_TOKEN_VERSION_2=0.0.0
APPLICATION_VERSION_THRESHOLD_FOR_TOKEN_VERSION_3=0.0.0
ENCRYPTION_SERVER_KEY=
PSEUDO_KEY_PARAMS_KEY=
VALET_TOKEN_SECRET=

# In-process legacy/push + worker WebSocket sync gateway. The connection secret
# and a reachable Redis host are required; without them sync capability remains
# off and clients use HTTP. Empty allowed origins derive exact PUBLIC_URL.
WEB_SOCKET_CONNECTION_TOKEN_SECRET=
WEB_SOCKET_CONNECTION_TOKEN_TTL=60s
WEBSOCKET_GATEWAY_INTERNAL_SECRET=
WEBSOCKET_SYNC_ENABLED=true
WEBSOCKET_SYNC_ALLOWED_ORIGINS=
WEBSOCKET_SYNC_MAX_SOCKETS_PER_USER=4
WEBSOCKET_SYNC_REDIS_KEY_PREFIX=srn:ws-sync:v1
WEBSOCKET_SYNC_REDIS_OPERATION_TIMEOUT_MS=1500
WEBSOCKET_SYNC_COMMAND_LEASE_TTL_MS=30000
WEBSOCKET_SYNC_SOCKET_LEASE_TTL_MS=75000
PUBLIC_URL=
REDIS_HOST=
REDIS_PORT=6379

FILES_SERVER_URL=

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
