LOG_LEVEL=debug
NODE_ENV=development
E2E_TESTING=false
# Optional. When unset, Node keeps its existing unspecified-interface default.
# Set 127.0.0.1 when a same-host reverse proxy must be the only public edge.
# BIND_ADDRESS=127.0.0.1

JWT_SECRET=
AUTH_JWT_SECRET=
APPLICATION_VERSION_THRESHOLD_FOR_TOKEN_VERSION_2=0.0.0
APPLICATION_VERSION_THRESHOLD_FOR_TOKEN_VERSION_3=0.0.0
ENCRYPTION_SERVER_KEY=
PSEUDO_KEY_PARAMS_KEY=
VALET_TOKEN_SECRET=

# In-process legacy/push + worker WebSocket sync gateway. WITHOUT REDIS_HOST NO
# GATEWAY IS ATTACHED AT ALL: no push, no live collaboration, presence or
# comments, no realtime invites, no push-approved multi-factor prompts. With
# Redis bound, the socket transport also needs the connection secret and the
# WEBSOCKET_SYNC_ENABLED kill switch left off. An admissible browser origin is
# checked per upgrade: the explicit list, an origin derived from PUBLIC_URL, or
# one equal to the request's own Host. There is no gRPC switch here -- the
# single process calls its durable sync journal directly, so realtime SYNC_ITEMS
# needs no SERVICE_PROXY_TYPE.
WEB_SOCKET_CONNECTION_TOKEN_SECRET=
# <n>s, <n>m, <n>h, or a bare integer meaning SECONDS. Validated at boot.
WEB_SOCKET_CONNECTION_TOKEN_TTL=60s
# Loopback-only: this value can mint a connection token FOR ANY USER.
WEBSOCKET_GATEWAY_INTERNAL_SECRET=
WEBSOCKET_SYNC_ENABLED=true
WEBSOCKET_SYNC_ALLOWED_ORIGINS=
WEBSOCKET_SYNC_MAX_SOCKETS_PER_USER=4
WEBSOCKET_SYNC_REDIS_KEY_PREFIX=srn:ws-sync:v1
WEBSOCKET_SYNC_REDIS_OPERATION_TIMEOUT_MS=1500
WEBSOCKET_SYNC_COMMAND_LEASE_TTL_MS=30000
WEBSOCKET_SYNC_SOCKET_LEASE_TTL_MS=75000
# Optional ^[a-z0-9:_-]{1,64}$ prefix for the realtime Redis names when two
# stacks share one Redis. Empty keeps today's names. An invalid value does NOT
# stop this process: it boots HTTP-only, attaches no gateway and records
# WEBSOCKET_REDIS_NAMESPACE_INVALID.
WEBSOCKET_REDIS_NAMESPACE=
PUBLIC_URL=
REDIS_HOST=
REDIS_PORT=6379

FILES_SERVER_URL=

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
