{
  "name": "@standard-red-notes/websocket-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted WebSocket push gateway for Standard Red Notes (replaces AWS API Gateway WebSocket push).",
  "main": "dist/gateway.js",
  "types": "dist/gateway.d.ts",
  "exports": {
    ".": {
      "types": "./dist/gateway.d.ts",
      "import": "./dist/gateway.js",
      "require": "./dist/gateway.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node e2e/realtime.e2e.mjs && node e2e/collab.e2e.mjs && node e2e/collab-yjs.e2e.mjs",
    "e2e:browser": "node e2e/browser.e2e.mjs && node e2e/feature-access.e2e.mjs && node e2e/account-export-import.e2e.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\" \"test/**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json,md}\" \"test/**/*.{ts,tsx,js,json,md}\""
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1088.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
