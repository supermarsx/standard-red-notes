{
  "name": "@standard-red-notes/websocket-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted WebSocket push gateway for Standard Red Notes (replaces AWS API Gateway WebSocket push).",
  "main": "dist/gateway.js",
  "types": "dist/gateway.d.ts",
  "exports": {
    ".": {
      "types": "./dist/gateway.d.ts",
      "import": "./dist/gateway.js",
      "require": "./dist/gateway.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run --coverage",
    "test:entry": "vitest run test/index.entry.test.ts",
    "e2e": "node e2e/realtime.e2e.mjs && node e2e/collab-yjs.e2e.mjs && node e2e/collab-end-to-end.e2e.mjs",
    "e2e:collab-yjs": "node e2e/collab-yjs.e2e.mjs",
    "e2e:collab-yjs:self-test": "node e2e/collab-yjs.e2e.mjs --self-test",
    "e2e:collab-end-to-end": "node e2e/collab-end-to-end.e2e.mjs",
    "e2e:collab-end-to-end:self-test": "node e2e/collab-end-to-end.e2e.mjs --self-test",
    "e2e:self-test": "node e2e/collab-yjs.e2e.mjs --self-test && node e2e/collab-end-to-end.e2e.mjs --self-test && node e2e/capability-fallback.e2e.mjs --self-test && node e2e/push-roundtrip.e2e.mjs --self-test",
    "e2e:push-roundtrip": "node e2e/push-roundtrip.e2e.mjs",
    "e2e:push-roundtrip:self-test": "node e2e/push-roundtrip.e2e.mjs --self-test",
    "e2e:sync-items-oversized": "node e2e/sync-items-oversized.e2e.mjs",
    "e2e:capability-fallback": "node e2e/capability-fallback.e2e.mjs",
    "e2e:capability-fallback:self-test": "node e2e/capability-fallback.e2e.mjs --self-test",
    "e2e:browser": "node e2e/browser.e2e.mjs && node e2e/feature-access.e2e.mjs && node e2e/account-export-import.e2e.mjs",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\" \"test/**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json,md}\" \"test/**/*.{ts,tsx,js,json,md}\""
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1147.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
