{
  "name": "@standardnotes/security",
  "version": "1.17.5",
  "engines": {
    "node": ">=26.0.0"
  },
  "description": "Security SDK for Standard Notes projects",
  "main": "dist/src/index.js",
  "author": "Standard Notes",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:standardnotes/server.git",
    "directory": "packages/security"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "clean": "rm -fr dist",
    "prestart": "yarn clean",
    "start": "tsc -p tsconfig.json --watch",
    "build": "tsc --build",
    "lint": "eslint . --ext .ts",
    "test": "jest --coverage --no-cache --maxWorkers=2"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "jest": "^30.4.2",
    "jest-util": "^30.4.1",
    "typescript": "6.0.3"
  }
}
