{
  "name": "inversify-express-utils",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "description": "Compatibility facade for the maintained Inversify Express 5 adapter",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "clean": "rm -fr dist",
    "build": "tsc --build",
    "lint": "eslint . --ext .ts",
    "test": "yarn build && node --test --experimental-test-coverage --test-coverage-include='dist/src/**' --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 test/index.integration.test.cjs test/index.unit.test.cjs"
  },
  "dependencies": {
    "@inversifyjs/http-core": "^5.4.5",
    "@inversifyjs/http-express": "^5.4.5",
    "express": "^5.2.1",
    "inversify": "^8.1.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "typescript": "6.0.3"
  }
}
