MODE=microservice # microservice | home-server | self-hosted
LOG_LEVEL=debug
NODE_ENV=development
VERSION=development

PORT=3000

SYNCING_SERVER_JS_URL=http://syncing_server_js:3000
SYNCING_SERVER_GRPC_URL=http://syncing_server_js:50052
AUTH_SERVER_URL=http://auth:3000
AUTH_SERVER_GRPC_URL=http://auth:50051
WEB_SOCKET_SERVER_URL=http://websockets:3000
PAYMENTS_SERVER_URL=http://payments:3000
FILES_SERVER_URL=http://files:3000
REVISIONS_SERVER_URL=http://revisions:3000
EMAIL_SERVER_URL=http://email:3000

HTTP_CALL_TIMEOUT=60000

AUTH_JWT_SECRET=auth_jwt_secret

CACHE_TYPE=redis
REDIS_URL=redis://cache

# (Optional) Caching Cross Service Tokens
CROSS_SERVICE_TOKEN_CACHE_TTL=

# ---- Assistant LLM proxy (server-held provider credentials) ----
# Anthropic
ASSISTANT_ANTHROPIC_API_KEY=
# OpenAI-compatible (OpenAI, LM Studio, Ollama, OpenRouter, custom)
ASSISTANT_OPENAI_API_KEY=
ASSISTANT_OPENAI_BASE_URL=
ASSISTANT_OPENAI_MODEL=
# Native Ollama (/api/chat)
ASSISTANT_OLLAMA_URL=
# Defaults / limits
ASSISTANT_DEFAULT_PROVIDER=
ASSISTANT_DEFAULT_MODEL=
# Per-user, per-day AI REQUEST cap (not tokens).
# WARNING: 0 or unset means UNLIMITED — this is the DEFAULT, so AI usage is
# uncapped out of the box. To cap usage you MUST set a POSITIVE integer here.
# Per-user override via the AI_REQUEST_LIMIT setting takes precedence. Enforced on
# /v1/assistant/stream (HTTP 429 past the cap) and reported by GET /v1/assistant/usage
# as { used, limit }.
ASSISTANT_DAILY_REQUEST_LIMIT=
# Comma-separated speech-to-text model ids advertised to clients for the audio
# recorder's transcription model picker (e.g. whisper-1,gpt-4o-transcribe). Empty
# = clients fall back to a free-text model field. Served at the public, read-only
# GET /v1/assistant/transcription/models endpoint.
TRANSCRIPTION_MODELS=

# ---- Realtime collaboration room authorization ----
# Lifetime (seconds) of the short-lived collaboration-room capability minted by
# POST /v1/collaboration/authorize and verified by the websocket-gateway on
# room-join. Default 300s; valid range 30..900 whole seconds. Invalid values
# stop gateway configuration instead of creating an unbounded capability.
# Shorter values reduce the maximum membership-revocation exposure. The
# capability is HS256-signed with
# WEB_SOCKET_CONNECTION_TOKEN_SECRET (the same secret the gateway already uses),
# so no extra secret is needed; if that secret is unset the authorize endpoint
# fails closed (denies) and collaboration room-join is rejected.
COLLABORATION_CAPABILITY_TTL_SECONDS=
# Maximum simultaneous realtime sockets per authenticated account. This allows
# several tabs/devices but bounds aggregate per-account ingress. Default 16;
# must be a positive whole number or the realtime gateway refuses to attach.
WEBSOCKET_MAX_CONNECTIONS_PER_USER=

# ---- OpenAI Codex / ChatGPT subscription mode (OPT-IN) ----
# Set to 'subscription' to authenticate the OpenAI-compatible provider with a
# ChatGPT/Codex subscription access token instead of an API key. Leave unset or
# 'api-key' to keep the default OpenAI API-key behavior (nothing changes).
ASSISTANT_OPENAI_AUTH_MODE=
# The ChatGPT/Codex subscription bearer token (OAuth access token / session token
# from a ChatGPT account login). See provider docs for how to obtain it.
ASSISTANT_OPENAI_SUBSCRIPTION_TOKEN=
# Base URL for the ChatGPT/Codex backend. UNVERIFIED default placeholder:
# https://chatgpt.com/backend-api/codex — confirm against a live subscription.
ASSISTANT_OPENAI_SUBSCRIPTION_BASE_URL=
# Optional ChatGPT account id (sent as the ChatGPT-Account-Id header).
ASSISTANT_OPENAI_ACCOUNT_ID=
# Optional OpenAI-Beta header value the Codex backend may require.
ASSISTANT_OPENAI_BETA=
# Optional extra headers (JSON object or comma-separated 'Key: Value' list),
# applied to every upstream request in both auth modes.
ASSISTANT_OPENAI_EXTRA_HEADERS=

# ---- Guided server-held ChatGPT/Codex pairing (OPT-IN, admin-only) ----
# This is separate from ASSISTANT_OPENAI_SUBSCRIPTION_TOKEN above. That variable
# is a legacy fallback only while guided pairing is not configured. Once this
# encrypted pairing subsystem is enabled, an absent/repair/unreadable default
# slot fails closed instead of silently resuming the env bearer. The guided flow
# holds one or more renewable OAuth credentials in an AES-256-GCM encrypted
# local file and selects them by subscription id. Generate exactly 32 random
# bytes and encode them as 64 hex characters. Keep this key outside the data
# backup; losing it makes the encrypted pairing file unrecoverable.
ASSISTANT_SUBSCRIPTION_ENCRYPTION_KEY=
# Persist this path if pairings must survive a container replacement. Pending
# PKCE state and short exchange claims are encrypted in the same file. Stock
# Compose uses a named volume path; this relative value suits a direct process.
ASSISTANT_SUBSCRIPTION_TOKEN_PATH=./data/assistant-subscription.json
# REQUIRED before pairing is enabled. Used to derive the default callback below;
# raw Compose deliberately supplies no localhost fallback. HTTPS is required
# outside loopback.
PUBLIC_URL=
# These best-effort provider values are not a stable public OpenAI API. Override
# them only with absolute HTTPS URLs (HTTP is allowed only on loopback). URL
# credentials, configured query parameters, and fragments are rejected.
ASSISTANT_CHATGPT_OAUTH_AUTHORIZE_URL=
ASSISTANT_CHATGPT_OAUTH_TOKEN_URL=
ASSISTANT_CHATGPT_OAUTH_CLIENT_ID=
ASSISTANT_CHATGPT_OAUTH_REDIRECT_URI=
ASSISTANT_CHATGPT_OAUTH_SCOPES=
ASSISTANT_CHATGPT_OAUTH_ACCOUNT_ID_CLAIM=

# ---- Workflows discovery (OPT-IN, link only) ----
# Both this operator switch and the authenticated user's WORKFLOWS_ENABLED
# setting must be true before the gateway reveals the link.
WORKFLOWS_ENABLED=
# Browser-facing n8n origin. Production requires a distinct HTTPS hostname
# outside COOKIE_DOMAIN. HTTP is accepted only for explicit loopback
# development. Credentials, queries, fragments, encoded authorities, and the
# Standard Red Notes hostname are rejected. PUBLIC_URL above is required so the
# gateway can enforce that separation without trusting the request Host header.
WORKFLOWS_PUBLIC_URL=

# ---- Publish note to GitHub (OPT-IN, server-mediated) ----
# Authenticated endpoint: POST /v1/integrations/github/publish
# Body: { token (GitHub PAT), owner, repo, branch?, path, content, message? }
# The gateway forwards the note (Markdown) + PAT to the GitHub Contents API. No
# server configuration is required — the PAT is supplied by the user per request
# and is never persisted or logged. The feature is inert until a user invokes it.
# PRIVACY: this sends DECRYPTED note content to the server and to GitHub (stored
# unencrypted), removing end-to-end encryption for the published copy.

# ---- Web proxy for the browser AI agent (fetch + search) ----
# Authenticated endpoints (same session auth as the assistant proxy):
#   POST /v1/web/fetch  { url }    -> { status, contentType, title, text }
#   POST /v1/web/search { query }  -> { results: [{ title, url, snippet }], error? }
# /v1/web/fetch retrieves a page server-side (no CORS) and returns its readable
# plain text (scripts/styles/markup stripped, capped at WEB_FETCH_MAX_CHARS).
# An SSRF guard rejects non-http(s) schemes and private/loopback/link-local/
# metadata hosts (localhost, 127/8, 169.254/16 incl. 169.254.169.254, 10/8,
# 172.16/12, 192.168/16, ::1, *.internal/*.local), resolving DNS names first.
#
# Search backend is selected by SEARCH_PROVIDER. Supported values:
#   searxng -> GET SEARCH_API_URL?q=<query>&format=json  (SearXNG JSON API;
#              SEARCH_API_KEY optional, sent as Bearer if set)
#   brave   -> GET SEARCH_API_URL?q=<query> with X-Subscription-Token: SEARCH_API_KEY
#              (Brave Search API; default URL https://api.search.brave.com/res/v1/web/search)
#   serper  -> POST SEARCH_API_URL { q } with X-API-KEY: SEARCH_API_KEY
#              (Serper.dev Google SERP; URL https://google.serper.dev/search)
# If SEARCH_PROVIDER / SEARCH_API_URL are unset, /v1/web/search returns HTTP 200
# with { results: [], error: 'web search not configured' } (never a 500).
SEARCH_PROVIDER=
SEARCH_API_URL=
SEARCH_API_KEY=
# Optional caps (defaults: 100000 chars, 15000 ms).
WEB_FETCH_MAX_CHARS=
WEB_FETCH_TIMEOUT_MS=

# ---- Read-only CalDAV feed of PUBLISHED reminders (OPT-IN, OFF BY DEFAULT) ----
# Lets standard CalDAV clients (Apple Calendar, Thunderbird, DAVx5) subscribe to
# a user's reminders/todos as a calendar.
#
# E2E PRIVACY: notes/reminders are end-to-end encrypted, so the server cannot
# read them. This feed serves ONLY reminders the user has EXPLICITLY PUBLISHED
# into a separate, server-readable store (plaintext by design) — never the E2E
# note content. Nothing is exposed until a user opts in AND publishes items.
#
# Two independent gates (BOTH required):
#   1. this operator master switch CALDAV_ENABLED (default false), AND
#   2. the per-user CALDAV_ENABLED setting ('true'), enforced when issuing a
#      scoped CalDAV token. CalDAV clients authenticate over HTTP Basic with that
#      scoped, revocable, read-only token (NOT the account password).
#
# Endpoints:
#   Token management (authenticated session):
#     GET    /v1/caldav/tokens/config   -> { caldavEnabled, allowed, available }
#     GET    /v1/caldav/tokens          -> { tokens: [...] }
#     POST   /v1/caldav/tokens          { label } -> { token: { ..., token } }   (plaintext shown once)
#     DELETE /v1/caldav/tokens/:uuid    -> { revoked: true }
#   CalDAV surface (HTTP Basic with the scoped token), under CALDAV_BASE_PATH:
#     OPTIONS / PROPFIND / REPORT / GET  (read-only: VTODO only in this slice)
CALDAV_ENABLED=
# Base path the CalDAV router is mounted at (default /dav).
CALDAV_BASE_PATH=
# Directory holding the CalDAV JSON stores (tokens.json + published.json).
# Default ./data/caldav relative to the process working directory.
CALDAV_DATA_PATH=

# ---- Server-side reminder DELIVERY (OPT-IN, OFF BY DEFAULT) ----
# Delivers DUE reminders to the user over Telegram / Email / WhatsApp.
#
# E2E PRIVACY: notes/reminders are end-to-end encrypted, so the server cannot
# read them. The server delivers ONLY reminders the user has EXPLICITLY PUBLISHED
# into a separate, server-readable store (plaintext by design) — never the E2E
# note content. Nothing is delivered until a user opts in, publishes reminders,
# AND configures a channel.
#
# Two independent gates (BOTH required):
#   1. this operator master switch REMINDER_DELIVERY_ENABLED (default false), AND
#   2. the per-user REMINDER_DELIVERY_ENABLED setting ('true'), enforced by the
#      authenticated /v1/reminder-delivery controller.
#
# A simple in-process scheduler scans published, unsent, due reminders every
# REMINDER_DELIVERY_INTERVAL_SECONDS and sends each via the user's configured
# channel adapter, marking it sent (or recording the failure for a later retry).
#
# Endpoints (authenticated session):
#   GET  /v1/reminder-delivery/config            -> { reminderDeliveryEnabled, allowed, available }
#   GET  /v1/reminder-delivery                   -> { reminders: [...] }
#   POST /v1/reminder-delivery   { id, message, dueAtUtc, channel?, destination? } -> { reminder }
#   GET  /v1/reminder-delivery/delivery-config   -> { config }
#   PUT  /v1/reminder-delivery/delivery-config   { channel, destination, enabled } -> { config }
REMINDER_DELIVERY_ENABLED=
# Scan interval in seconds (default 60).
REMINDER_DELIVERY_INTERVAL_SECONDS=
# Directory holding the JSON stores (published-reminders.json + delivery-config.json).
# Default ./data/reminder-delivery relative to the process working directory.
REMINDER_DELIVERY_DATA_PATH=
#
# --- Per-channel credentials (each adapter NO-OPs gracefully when unset) ---
# Telegram Bot HTTP API. Create a bot via @BotFather; destination is the chat id.
TELEGRAM_BOT_TOKEN=
# Email via SMTP. SMTP_HOST + SMTP_FROM are the minimum to send. TLS is required
# by default: SMTP_SECURE=true selects implicit TLS (typically port 465);
# otherwise STARTTLS must succeed.
# SECURITY WARNING: SMTP_ALLOW_INSECURE=true sends credentials and reminders in
# plaintext. It is rejected for public hostnames and exists only for a trusted
# loopback, private-IP, or single-label internal relay.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Historical standalone-gateway alias; prefer SMTP_PASS.
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=
SMTP_ALLOW_INSECURE=
# WhatsApp — configure EITHER Meta Cloud API OR Twilio (Meta wins if both set).
# Meta WhatsApp Cloud API:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Twilio (WhatsApp):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
