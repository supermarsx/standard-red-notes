{
  "compilerOptions": {
    "alwaysStrict": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "removeComments": false,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "es2022",
    "types": ["node", "jest"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
  },
  // This project doubles as the solution file and as a catch-all compile of every
  // source the referenced projects do not own. websocket-gateway is deliberately
  // out: it is a standalone NodeNext/ESM project, so the catch-all was checking it
  // under the wrong module settings and — having no outDir — emitting .js/.d.ts
  // next to its sources. Its own tsconfig.json + tsconfig.test.json cover it fully.
  "exclude": ["**/*.spec.ts", "dist", "test-setup.ts", "packages/websocket-gateway"],
  "references": [
    {
      "path": "./packages/analytics"
    },
    {
      "path": "./packages/api-gateway"
    },
    {
      "path": "./packages/auth"
    },
    {
      "path": "./packages/common"
    },
    {
      "path": "./packages/domain-core"
    },
    {
      "path": "./packages/domain-events"
    },
    {
      "path": "./packages/domain-events-infra"
    },
    {
      "path": "./packages/files"
    },
    {
      "path": "./packages/grpc"
    },
    {
      "path": "./packages/inversify-express-utils"
    },
    {
      "path": "./packages/predicates"
    },
    {
      "path": "./packages/revisions"
    },
    {
      "path": "./packages/scheduler"
    },
    {
      "path": "./packages/security"
    },
    {
      "path": "./packages/settings"
    },
    {
      "path": "./packages/syncing-server"
    },
    {
      "path": "./packages/time"
    },
    {
      "path": "./packages/websockets"
    }
  ]
}
