{
  "name": "@standard-red-notes/server-monorepo",
  "private": true,
  "author": "Standard Red Notes",
  "license": "AGPL-3.0-only",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "lint": "yarn workspaces foreach -ptA run lint",
    "lint:fix": "yarn workspaces foreach -ptA run lint:fix",
    "clean": "yarn workspaces foreach -ptA run clean",
    "build": "yarn workspaces foreach -ptA run build",
    "test": "yarn workspaces foreach -ptA run test",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,js,json,md}\" \"packages/*/bin/**/*.{ts,tsx}\" \"packages/*/migrations/**/*.ts\" \"*.config.js\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,js,json,md}\" \"packages/*/bin/**/*.{ts,tsx}\" \"packages/*/migrations/**/*.ts\" \"*.config.js\"",
    "setup:env": "cp .env.sample .env && yarn workspaces foreach -ptA run setup:env",
    "release": "lerna version --conventional-graduate --conventional-commits --yes -m \"chore(release): publish new version\"",
    "publish": "lerna publish from-git --yes --no-verify-access --loglevel verbose",
    "postversion": "./scripts/push-tags-one-by-one.sh",
    "e2e": "yarn build && PORT=3123 yarn workspace @standardnotes/home-server start",
    "start": "yarn build && yarn workspace @standardnotes/home-server start"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@lerna-lite/cli": "^5.6.2",
    "@lerna-lite/list": "^5.6.2",
    "@lerna-lite/publish": "^5.6.2",
    "@lerna-lite/run": "^5.6.2",
    "@lerna-lite/version": "^5.6.2",
    "@typeorm/codemod": "^1.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "ini": "^7.0.0",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "yarn@4.17.1",
  "resolutions": {
    "@grpc/grpc-js@npm:^1.14.3": "npm:1.14.5",
    "babel-plugin-istanbul": "npm:8.0.0",
    "brace-expansion@npm:^5.0.5": "npm:5.0.12",
    "browserslist@npm:^4.24.0": "npm:4.28.9",
    "browserslist@npm:^4.28.1": "npm:4.28.9",
    "dompurify": "npm:3.4.16",
    "fast-uri@npm:^3.0.1": "npm:3.1.8",
    "glob": "npm:13.0.6",
    "handlebars": "npm:4.7.10",
    "js-yaml@npm:^3.13.1": "npm:3.15.2",
    "js-yaml@npm:^4.1.0": "npm:4.3.2",
    "proxy-addr@npm:^2.0.7": "npm:2.0.8",
    "source-map-js@npm:^1.2.1": "npm:1.2.2",
    "undici@npm:^6.25.0": "npm:6.28.1",
    "undici@npm:^8.4.1": "npm:8.10.2"
  },
  "dependenciesMeta": {
    "grpc-tools@1.12.4": {
      "unplugged": true
    },
    "grpc_tools_node_protoc_ts@5.3.3": {
      "unplugged": true
    }
  }
}
